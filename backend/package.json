{
  "name": "gamesato-backend",
  "version": "1.0.0",
  "description": "Backend server for Gamesato H5 Game Portal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node run-migration.js",
    "db:setup": "node scripts/setup-production-db.js",
    "db:dump": "pg_dump $DATABASE_URL --clean --if-exists -f src/config/full_gamesato_dump.sql",
    "db:restore": "psql $DATABASE_URL -f src/config/full_gamesato_dump.sql",
    "convert-webp": "node scripts/convert_to_webp.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
